// Demo: errors — Result + ? with std::error::Error.
// Layered error conversion (leaf → app enum via From) is in tests/cli/fixtures/std_try_from/.

#import std::core::result::{Err, Ok, Result};
#import std::error::Error;

Config :: struct {
    value: s32,
};

read_bytes :: () => Result<Config, Error> {
    Ok(Config { value: 42 })
};

read_config :: () => Result<Config, Error> {
    const cfg = read_bytes()?;
    Ok(cfg)
};

main :: () => {
    match read_config() {
        Ok(c) => { const _ = c.value; };
        Err(e) => { const _ = e; };
    };
};
