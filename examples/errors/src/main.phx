// Demo: errors — layered Result + ? with From conversion across std error types.

#import std::core::result::Err;
#import std::core::result::Ok;
#import std::core::result::Result;
#import std::error::Error;
#import std::error::IoError;

Config :: struct {
    value: s32,
};

read_bytes :: () => Result<Config, IoError> {
    Ok(Config { value: 42 })
};

read_config :: () => Result<Config, Error> {
    const cfg = read_bytes()?;
    Ok(cfg)
};

main :: () => {
    match read_config() {
        Ok(c) => { const _ = c.value; };
        Err(e) => { const _ = e; };
    };
};
