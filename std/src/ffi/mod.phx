// std::ffi — C scalar type aliases (fixed-width v0 mapping; see docs/design/features/ffi.md).

pub type c_void = ();
pub type c_char = u8;
pub type c_uchar = u8;
pub type c_schar = s8;
pub type c_short = s16;
pub type c_ushort = u16;
pub type c_int = s32;
pub type c_uint = u32;
pub type c_long = s64;
pub type c_ulong = u64;
pub type c_size = u64;
pub type c_ssize = s64;
pub type c_float = f32;
pub type c_double = f64;
