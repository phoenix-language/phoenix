    };
};

u32 :: impl :: Display {
    fmt :: (self: &Self) => [u8; 32] {
        format_u32(*self)
    };
};

u32 :: impl :: Debug {
    fmt :: (self: &Self) => [u8; 32] {
        format_u32(*self)
    };
};

u64 :: impl :: Display {
    fmt :: (self: &Self) => [u8; 32] {
