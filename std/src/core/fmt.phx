        format_u8(*self)
    };
};

u8 :: impl :: Debug {
    fmt :: (self: &Self) => [u8; 32] {
        format_u8(*self)
    };
};

u16 :: impl :: Display {
    fmt :: (self: &Self) => [u8; 32] {
        format_u16(*self)
    };
};

u16 :: impl :: Debug {
    fmt :: (self: &Self) => [u8; 32] {
