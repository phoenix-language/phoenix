bool :: impl :: Display {
    fmt :: (self: &Self) => [u8; 32] {
        format_bool(*self)
    };
};

bool :: impl :: Debug {
    fmt :: (self: &Self) => [u8; 32] {
        format_bool(*self)
    };
};

