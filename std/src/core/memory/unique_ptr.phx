// std::core::memory::unique_ptr — single-owner heap pointer (Rust `Box` equivalent).

#import std::core::drop::Drop;
#import std::core::memory::allocator::{Allocator, Global, Layout};

pub UniquePtr :: <t> struct {
    ptr: *mut t,
    layout: Layout,
    alloc: Global,
};

UniquePtr :: <t> impl {
    new :: (value: t, byte_layout: Layout, alloc: Global) => UniquePtr<t> {
        unsafe {
            var mut_alloc: Global = alloc;
            const raw: *mut u8 = mut_alloc.alloc(byte_layout);
            const ptr: *mut t = raw as *mut t;
            *ptr = value;
            UniquePtr :: <t> { ptr: ptr, layout: byte_layout, alloc: mut_alloc };
        };
    };

    get :: (self: &Self) => t {
        unsafe {
            *self.ptr
        };
    };
};

UniquePtr :: <t> impl :: Drop {
    drop :: (self) => () {
        unsafe {
            var mut_alloc: Global = self.alloc;
            mut_alloc.dealloc(self.ptr as *mut u8, self.layout);
        };
    };
};
