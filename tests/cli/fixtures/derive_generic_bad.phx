Copyable :: trait {};

#derive(Copyable)
Box :: <t> struct {
    v: t,
};

Holder :: struct {
    r: &s32,
};

max :: <t: Copyable> (a: t, b: t) => t {
    a
};

main :: () => {
    var n: s32 = 1;
    const left = Box :: <Holder> { v: Holder { r: &n } };
    const right = Box :: <Holder> { v: Holder { r: &n } };
    const _unused = max(left, right);
};
