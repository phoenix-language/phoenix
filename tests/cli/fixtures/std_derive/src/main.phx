#[derive(PartialEq, Copyable)]
Rect :: struct {
    w: s32,
    h: s32,
};

main :: () => {
    var a: Rect = Rect { w: 2, h: 3 };
    var b: Rect = Rect { w: 2, h: 3 };
    var c: Rect = Rect { w: 1, h: 3 };
    const same: bool = a.eq(&b);
    const diff: bool = a.eq(&c);
    const _ = same;
    const _discard = diff;
};
