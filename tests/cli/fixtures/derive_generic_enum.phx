PartialEq :: trait {
    eq :: (self: &Self, other: &Self) => bool;
};

#derive(PartialEq)
Maybe :: <t> enum {
    None,
    Other(s32),
};

main :: () => {
    var a: Maybe<s32> = Other(1);
    var b: Maybe<s32> = Other(1);
    var c: Maybe<s32> = None :: <s32>();
    const same: bool = a.eq(&b);
    const diff: bool = a.eq(&c);
    const _ = same;
    const _discard = diff;
};
