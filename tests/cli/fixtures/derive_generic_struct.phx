PartialEq :: trait {
    eq :: (self: &Self, other: &Self) => bool;
};

#derive(PartialEq)
Box :: <t> struct {
    v: s32,
};

main :: () => {
    var a: Box<s32> = Box :: <s32> { v: 1 };
    var b: Box<s32> = Box :: <s32> { v: 1 };
    var c: Box<s32> = Box :: <s32> { v: 2 };
    const same: bool = a.eq(&b);
    const diff: bool = a.eq(&c);
    const _ = same;
    const _discard = diff;
};
