#import std::core::option::Option;
#import std::core::option::Some;
#import std::core::option::None;
#import std::core::result::Result;
#import std::core::result::Ok;
#import std::core::result::Err;

read_bytes :: (path: [u8]) => Result<s32, s32> {
    const _ignore = path;
    Ok(1)
};

read_config :: (path: [u8]) => Result<s32, s32> {
    const n = read_bytes(path)?;
    Ok(n + 41)
};

main :: () => {
    const path = b"\x00";
    match read_config(path as [u8]) {
        Ok(v) => { const _ = v; };
        Err(e) => { const _ = e; };
    };
};
