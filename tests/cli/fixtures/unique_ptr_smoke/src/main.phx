#import std::core::memory::allocator::{Layout, VmHeapAllocator};
#import std::core::memory::unique_ptr::UniquePtr;

main :: () => {
    const layout: Layout = Layout { size: 4u, align: 1u };
    {
        const ptr: UniquePtr<s32> = UniquePtr :: <s32>::new(42, layout, VmHeapAllocator {});
        const v: s32 = ptr.get();
        const _ = v;
    };
};
