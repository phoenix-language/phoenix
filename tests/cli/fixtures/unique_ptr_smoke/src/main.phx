#import std::core::memory::allocator::{Layout, VmHeapAllocator};
#import std::core::memory::unique_ptr::UniquePtr;

main :: () => {
    const layout: Layout = Layout { size: 4u, align: 1u };
    {
        const ptr: UniquePtr<s32> = unsafe {
            var g: VmHeapAllocator = VmHeapAllocator {};
            const raw: *mut u8 = g.alloc(layout);
            const p: *mut s32 = raw as *mut s32;
            *p = 42;
            UniquePtr :: <s32> { ptr: p, layout: layout, alloc: g }
        };
        const v: s32 = ptr.get();
        const _ = v;
    };
};
