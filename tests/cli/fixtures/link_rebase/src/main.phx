#import types::point::{Point, get_x};

mod types;

Outcome :: enum {
    Ok { v: s32 },
    Err { code: s32 },
};

main :: () => {
    const p: Point = Point { x: 10, y: 20 };
    const field: s32 = get_x(p);
    const r: Outcome = Ok { v: field };
    const _ = match r {
        Ok { v } => v;
        Err { code } => code;
    };
};
