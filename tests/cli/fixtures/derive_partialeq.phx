PartialEq :: trait {
    eq :: (self: &Self, other: &Self) => bool;
};

#[derive(PartialEq)]
Point :: struct {
    x: s32,
    y: s32,
};

main :: () => {
    var p: Point = Point { x: 1, y: 2 };
    var q: Point = Point { x: 1, y: 2 };
    var r: Point = Point { x: 0, y: 2 };
    const same: bool = p.eq(&q);
    const diff: bool = p.eq(&r);
    const _ = same;
    const _discard = diff;
};
