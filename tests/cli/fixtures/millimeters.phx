PartialEq :: trait {
    eq :: (self: &Self, other: &Self) => bool;
};

#derive(PartialEq)
Millimeters :: struct(s32);

Millimeters :: impl {
    as_s32 :: (self: &Self) => s32 {
        self.0
    };
};

accept :: (m: Millimeters) => () {
    const _ = m;
};

main :: () => {
    const length: Millimeters = Millimeters(500);
    accept(length);
    const raw: s32 = length.as_s32();
    const _ = raw;
};
