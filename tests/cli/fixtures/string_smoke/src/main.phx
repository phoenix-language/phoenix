#import std::text::string::String;

main :: () => {
    var s: String = String::from_str("hello");
    s.push(33u as u8);
    const n: u32 = s.len();
    const first: u8 = s.get(0u);
    const last: u8 = s.get(n - 1u);
    const check_len: u32 = n;
    const check_first: u8 = first;
    const check_last: u8 = last;
};
