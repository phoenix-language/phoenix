// Short-circuit && and || in if conditions.

main :: () => {
  const a: bool = { if 1 == 1 { true } else { false } };
  const b: bool = { if 1 == 2 { true } else { false } };
  const c: bool = a && b;
  const d: bool = a || b;
  const ok: bool = { if (c || d) { true } else { false } };
  const _ = ok;
};
