#import std::core::error::Error;
#import std::core::result::{Err, Ok, Result};

Config :: struct {
    value: s32,
};

AppError :: struct {
    code: s32,
};

AppError :: impl :: Error {
};

read_bytes :: () => Result<Config, AppError> {
    Ok(Config { value: 42 })
};

read_config :: () => Result<Config, AppError> {
    const cfg = read_bytes()?;
    Ok(cfg)
};

main :: () => {
    match read_config() {
        Ok(c) => { const _ = c.value; };
        Err(e) => { const _ = e; };
    };
};
