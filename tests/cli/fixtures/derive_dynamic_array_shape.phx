PartialEq :: trait {
    eq :: (self: &Self, other: &Self) => bool;
};

Debug :: trait {
    fmt :: (self: &Self) => [u8; 32];
};

Drop :: trait {
    drop :: (self) => ();
};

#[derive(PartialEq, Debug)]
DynamicArray :: <t> struct {
    len: u32,
    cap: u32,
};

DynamicArray :: <t> impl :: Drop {
    drop :: (self) => () {};
};

main :: () => {
    const a = DynamicArray :: <s32> { len: 1u, cap: 4u };
    const b = DynamicArray :: <s32> { len: 1u, cap: 4u };
    const _: bool = a.eq(&b);
};
